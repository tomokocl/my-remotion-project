{
  "name": "calendar-sync",
  "version": "1.0.0",
  "description": "One-way Google Calendar sync (A → B) with busy blocks",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "setup:a": "tsx src/setup.ts A",
    "setup:b": "tsx src/setup.ts B"
  },
  "dependencies": {
    "express": "^4.21.0",
    "googleapis": "^144.0.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
