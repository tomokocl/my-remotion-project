# Google OAuth2 credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

# OAuth2 refresh tokens (obtained via setup script)
ACCOUNT_A_REFRESH_TOKEN=
ACCOUNT_B_REFRESH_TOKEN=

# Calendar IDs (usually the email address, or "primary")
ACCOUNT_A_CALENDAR_ID=primary
ACCOUNT_B_CALENDAR_ID=primary

# Webhook server settings
PORT=3000
WEBHOOK_BASE_URL=https://your-vps-domain.com
