{
  "name": "note-to-pdf",
  "version": "1.0.0",
  "description": "note.com記事をPDFに変換するアプリ",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "note-to-pdf": "node scripts/note-to-pdf.mjs",
    "web": "node server.mjs",
    "electron": "electron .",
    "dist": "set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.note-to-pdf",
    "productName": "note-to-PDF",
    "win": {
      "target": "portable"
    },
    "files": [
      "electron-main.cjs",
      "node_modules/**/*",
      "scripts/**/*"
    ]
  },
  "repository": {},
  "license": "UNLICENSED",
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/zod-types": "^4.0.0",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "playwright-core": "^1.58.2",
    "puppeteer-core": "^24.39.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "^4.0.0",
    "zod": "3.22.3"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "^4.0.0",
    "@types/react": "19.0.0",
    "@types/web": "0.0.166",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "9.19.0",
    "prettier": "3.6.0",
    "typescript": "5.8.2"
  },
  "private": true
}
